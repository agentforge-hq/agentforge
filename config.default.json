  "budgets": {"index_tokens": 3500, "eager_tokens": 2000, "skill_tokens": 2000, "router_tokens": 1000, "description_tokens": 100},
  "limits": {"file_bytes": 1048576, "hash_file_bytes": 134217728, "tree_bytes": 268435456, "extract_bytes": 20971520, "tree_files": 5000, "scan_dirs": 10000, "download_bytes": 26214400},
  "sdqs_weights": {"structure": 20, "routing": 20, "economy": 20, "execution": 20, "maintenance": 10, "safety": 10},
