      "rules": [{"path": "{project}/AGENTS.md", "load": "candidate"}, {"path": "{project}/CLAUDE.md", "load": "candidate"}],
      "frontmatter": ["name", "description", "license", "compatibility", "metadata", "allowed-tools", "argument-hint", "triggers"],
      "isolation": null,
      "source": "https://docs.devin.ai/product-guides/skills"
    },
    "gemini": {
      "status": "documented; extension and system roots need explicit configuration",
