      "rules": [{"path": "{project}/.cursor/rules/**/*.mdc", "load": "frontmatter"}, {"path": "{project}/AGENTS.md", "load": "always"}, {"path": "{project}/.cursorrules", "load": "candidate"}],
      "frontmatter": ["name", "description", "license", "compatibility", "metadata", "allowed-tools", "disable-model-invocation", "paths"],
